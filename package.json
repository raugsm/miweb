{
  "name": "ariad-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web unica Ariad: AriadDesbloqueador + AriadGSM (portal, panel y API) en una sola SPA React-TS.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node server.js\" \"vite\"",
    "dev:api": "node server.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --import ./scripts/disable-env-file.mjs --test test/phase3a.contract.test.js test/phase4.smoke.test.js test/phase5.technician-swap.test.js test/postgres-storage-guard.test.js test/postgres-auth.test.js test/portal-granular-auth.test.js test/operator-granular-auth.test.js test/audit-events-granular.test.js test/frp-payment-review-postgres.test.js test/portal-customer-confirm-postgres.test.js test/payment-verification-shadow.test.js test/web-hardening-cloud-sync.test.js test/portal-guest.test.js test/pricing-v2.test.js test/public-frp-prices.test.js test/portal-guest-routes.test.js test/portal-guest-claim.test.js test/portal-guest-sse.test.js test/public-campaign-tracking.test.js",
    "test:smoke": "node --import ./scripts/disable-env-file.mjs --test test/phase4.smoke.test.js",
    "postgres:check": "node scripts/postgres/check-connection.mjs",
    "postgres:migrate": "node scripts/postgres/apply-migrations.mjs",
    "postgres:migrate:apply": "node scripts/postgres/apply-migrations.mjs --apply",
    "postgres:import": "node scripts/migration/import-users-json-to-postgres.mjs",
    "postgres:import:apply": "node scripts/migration/import-users-json-to-postgres.mjs --apply",
    "postgres:read-check": "node scripts/postgres/read-db-check.mjs",
    "postgres:sync-drift": "node scripts/postgres/sync-json-drift.mjs",
    "postgres:sync-drift:apply": "node scripts/postgres/sync-json-drift.mjs --apply",
    "postgres:write-check": "node scripts/postgres/write-db-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "flag-icons": "^7.5.0",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^1.45.0",
    "nodemailer": "^8.0.7",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
